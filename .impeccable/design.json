  "narrative": {
    "northStar": "Midnight navy + ice blue + off-white",
    "overview": "The owner's chosen midnight navy, ice blue, and off-white palette frames a portfolio of real technical and creative work. Broad dark sections and light reading surfaces establish hierarchy; restrained blue accents connect actions, emphasis, and diagrams.\n\nThis record describes the current build in assets/home.css. Preserve its Helvetica Neue typography, page composition, and original media when extending the palette. The retained web-systems archive also uses assets/portfolio.css and assets/2026.css; its older rounded and elevated patterns are a compatibility boundary, not defaults for new surfaces.",
    "keyCharacteristics": [
      "Midnight navy anchors with ice blue emphasis.",
      "Off-white and soft blue reading surfaces.",
      "Bold Helvetica Neue headings, generous spacing, and thin dividers.",
      "Flat, square-cornered controls in the main site.",
      "Real screenshots and photographs retain their original content."
    ],
    "rules": [
      {
        "name": "The Palette Continuity Rule",
        "body": "Use the approved navy, ice blue, and off-white roles for new brand surfaces; preserve the meaning of error and focus states.",
        "section": "colors"
      },
      {
        "name": "The Existing Type Rule",
        "body": "Keep the bundled Helvetica Neue family and the observed bold-heading/body relationship when extending the current site.",
        "section": "typography"
      },
      {
        "name": "The Main Surface Rule",
        "body": "Use tonal section changes and thin rules for depth on the main site; preserve archive-specific treatments only within the existing archive.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use ice blue for primary actions and emphasis on navy.",
      "Do retain off-white and soft blue surfaces with dark text for long reading.",
      "Do preserve the current typography, responsive composition, real photographs, and interface screenshots.",
      "Do keep visible focus, form hints, errors, and reduced-motion support."
    ],
    "donts": [
      "Don't reintroduce the former green brand palette on new public surfaces.",
      "Don't treat ice blue as small text on the off-white reading surface.",
      "Don't inherit the archive's radius and shadow vocabulary into new main-site components by default.",
      "Don't recolor real media or document contents merely to match the site palette."
    ]
  }
}
